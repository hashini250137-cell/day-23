interface Employee {
    void salary();
}

class Manager implements Employee {
    public void salary() {
        System.out.println("Manager Salary: 50000");
    }
}

class Clerk implements Employee {
    public void salary() {
        System.out.println("Clerk Salary: 25000");
    }
}

public class Main {
    public static void main(String[] args) {
        Manager m = new Manager();
        Clerk c = new Clerk();

        m.salary();
        c.salary();
    }
}
