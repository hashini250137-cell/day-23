interface Shape {
    void area();
}

class Circle implements Shape {
    public void area() {
        int r = 5;
        System.out.println("Circle Area: " + (3.14 * r * r));
    }
}

class Rectangle implements Shape {
    public void area() {
        int l = 10, b = 5;
        System.out.println("Rectangle Area: " + (l * b));
    }
}

public class Main {
    public static void main(String[] args) {
        Circle c = new Circle();
        Rectangle r = new Rectangle();

        c.area();
        r.area();
    }
}
